from playwright.sync_api import sync_playwright
import pandas as pd
import ctypes
import builtins
from datetime import datetime

# ============================================================
# CONFIGURATION
# ============================================================

LOADER_CSS = "div.loader"
EXCEL_PATH = "input1.xlsx"

EXCEL_HOSTNAME_COLUMN = "hostname"
EXCEL_STRATEGY_COLUMN = "rstrategy"

# ============================================================
# SUMMARY VARIABLES
# ============================================================

automation_start_time = datetime.now()

total_applications_processed = 0
total_strategy_updates = 0
total_skipped = 0
total_already_matching = 0
total_not_found_in_excel = 0
total_errors = 0
error_details = []

current_application_name = "APP_16_1"

# Keep console quiet during automation.
original_print = builtins.print

def print(*args, **kwargs):
    pass

# ============================================================
# PREVENT WINDOWS SLEEP
# ============================================================

ES_CONTINUOUS = 0x80000000
ES_SYSTEM_REQUIRED = 0x00000001
ES_DISPLAY_REQUIRED = 0x00000002

def prevent_system_sleep():
    global total_errors
    try:
        ctypes.windll.kernel32.SetThreadExecutionState(
            ES_CONTINUOUS | ES_SYSTEM_REQUIRED | ES_DISPLAY_REQUIRED
        )
    except Exception as sleep_error:
        total_errors += 1
        error_details.append({
            "application": "System",
            "vm_hostname": "N/A",
            "error": f"Unable to prevent the system from sleeping: {sleep_error}"
        })

def allow_system_sleep():
    try:
        ctypes.windll.kernel32.SetThreadExecutionState(ES_CONTINUOUS)
    except Exception:
        pass

# ============================================================
# READ EXCEL - FAST LOOKUP
# ============================================================

excel_df = pd.read_excel(EXCEL_PATH, engine="openpyxl")
excel_df.columns = excel_df.columns.astype(str).str.strip()

if EXCEL_HOSTNAME_COLUMN not in excel_df.columns:
    raise ValueError(
        f"Column '{EXCEL_HOSTNAME_COLUMN}' was not found in Excel. "
        f"Available columns: {excel_df.columns.tolist()}"
    )

if EXCEL_STRATEGY_COLUMN not in excel_df.columns:
    raise ValueError(
        f"Column '{EXCEL_STRATEGY_COLUMN}' was not found in Excel. "
        f"Available columns: {excel_df.columns.tolist()}"
    )

valid_excel = excel_df[
    excel_df[EXCEL_HOSTNAME_COLUMN].notna()
    & excel_df[EXCEL_STRATEGY_COLUMN].notna()
].copy()

valid_excel[EXCEL_HOSTNAME_COLUMN] = (
    valid_excel[EXCEL_HOSTNAME_COLUMN].astype(str).str.strip().str.lower()
)
valid_excel[EXCEL_STRATEGY_COLUMN] = (
    valid_excel[EXCEL_STRATEGY_COLUMN].astype(str).str.strip()
)

hostname_strategy = dict(
    zip(
        valid_excel[EXCEL_HOSTNAME_COLUMN],
        valid_excel[EXCEL_STRATEGY_COLUMN]
    )
)

# ============================================================
# STRATEGY HELPERS
# ============================================================

def get_dropdown_strategy(excel_strategy):
    strategy_mapping = {
        "replatform": "Re-Platform"
    }
    cleaned_strategy = str(excel_strategy).strip()
    return strategy_mapping.get(cleaned_strategy.lower(), cleaned_strategy)

def normalize_strategy(strategy):
    if strategy is None:
        return ""
    return (
        str(strategy)
        .strip()
        .lower()
        .replace("-", "")
        .replace(" ", "")
    )

# ============================================================
# PLAYWRIGHT HELPERS
# ============================================================

def get_table():
    table = page.locator("table.min-w-full")
    table.wait_for(state="visible", timeout=30000)
    return table

def get_required_column_indexes(table):
    headers = table.locator("th")
    count = headers.count()

    vm_hostname_column = None
    platform_strategy_column = None

    for header_index in range(count):
        header_text = headers.nth(header_index).inner_text().strip()

        if header_text == "VM Hostname":
            vm_hostname_column = header_index
        elif header_text == "Platform Migration Strategy":
            platform_strategy_column = header_index

        if vm_hostname_column is not None and platform_strategy_column is not None:
            break

    if vm_hostname_column is None:
        raise Exception(
            "Unable to find the 'VM Hostname' column in the website table."
        )

    if platform_strategy_column is None:
        raise Exception(
            "Unable to find the 'Platform Migration Strategy' column "
            "in the website table."
        )

    return vm_hostname_column, platform_strategy_column

def wait_for_loader_after_action():
    """
    Optimized loader handling.

    The old code could spend up to 3 seconds checking loader visibility
    before starting the actual wait. Here, if the loader is already visible,
    we wait for it to disappear; otherwise we continue immediately.
    """
    loader = page.locator(LOADER_CSS)

    try:
        if loader.count() > 0 and loader.first.is_visible():
            loader.first.wait_for(state="hidden", timeout=120000)
    except Exception:
        # The UI can remove the loader between the visibility check and wait.
        get_table()

def wait_for_table_refresh(old_first_row_text=None):
    """
    Wait for the table to be usable after pagination.
    No fixed multi-second sleep is used.
    """
    table = get_table()

    if old_first_row_text is not None:
        try:
            page.wait_for_function(
                """([selector, oldText]) => {
                    const table = document.querySelector(selector);
                    if (!table) return false;
                    const row = table.querySelector("tbody tr");
                    if (!row) return false;
                    return row.innerText !== oldText;
                }""",
                ["table.min-w-full", old_first_row_text],
                timeout=30000
            )
        except Exception:
            # Some tables re-render without changing the first row.
            get_table()

    return table

def get_next_button():
    return page.locator(
        "button:has(path[d='M6 12L10 8L6 4'])"
    ).first

# ============================================================
# UPDATE ONE ROW
# ============================================================

def update_row(data, vm_hostname_column, platform_strategy_column, app):
    global total_strategy_updates
    global total_skipped
    global total_not_found_in_excel
    global total_already_matching
    global total_errors

    vm_hostname = "Unable to read VM hostname"

    try:
        cells = data.locator("td")

        vm_hostname = cells.nth(vm_hostname_column).inner_text().strip()
        current_strategy = (
            cells.nth(platform_strategy_column).inner_text().strip()
        )

        excel_strategy = hostname_strategy.get(vm_hostname.lower())

        if excel_strategy is None:
            total_skipped += 1
            total_not_found_in_excel += 1
            return

        if normalize_strategy(current_strategy) == normalize_strategy(excel_strategy):
            total_skipped += 1
            total_already_matching += 1
            return

        dropdown_strategy = get_dropdown_strategy(excel_strategy)

        edit_button = data.locator('button[title="Edit"]')
        edit_button.click()

        drop = data.locator("select").first
        drop.wait_for(state="visible", timeout=10000)
        drop.select_option(value=dropdown_strategy)

        comment = page.locator(
            'textarea[placeholder="Please state reason."]'
        ).first
        comment.wait_for(state="visible", timeout=10000)
        comment.fill(".")

        save_button = page.locator('button[title="Save"]').first
        save_button.wait_for(state="visible", timeout=10000)
        save_button.click()

        # Critical optimization: no 3-second visibility wait.
        wait_for_loader_after_action()

        total_strategy_updates += 1

    except Exception as row_error:
        total_errors += 1
        error_details.append({
            "application": app,
            "vm_hostname": vm_hostname,
            "error": str(row_error)
        })

# ============================================================
# PROCESS CURRENT APPLICATION
# ============================================================

def process_application(app):
    global total_applications_processed

    next_btn = get_next_button()

    while True:
        table = get_table()
        tbody_rows = table.locator("tbody tr")

        if tbody_rows.count() > 0:
            rows = tbody_rows
            start_index = 0
        else:
            rows = table.locator("tr")
            start_index = 1

        row_count = rows.count()

        vm_hostname_column, platform_strategy_column = (
            get_required_column_indexes(table)
        )

        for i in range(start_index, row_count):
            data = rows.nth(i)
            update_row(
                data,
                vm_hostname_column,
                platform_strategy_column,
                app
            )

        if next_btn.is_enabled():
            try:
                old_first_row_text = (
                    rows.first.inner_text().strip()
                    if row_count > 0 else None
                )
            except Exception:
                old_first_row_text = None

            next_btn.click()
            wait_for_table_refresh(old_first_row_text)
        else:
            break

    total_applications_processed += 1

# ============================================================
# START PLAYWRIGHT
# ============================================================

p = sync_playwright().start()
browser = p.chromium.connect_over_cdp("http://127.0.0.1:9432")
contxt = browser.contexts[0]
page = contxt.pages[0]

# ============================================================
# GET APPLICATION LIST
# ============================================================

select_app = page.locator('//span[text()="Select Application"]').first
select_app.wait_for(state="visible", timeout=30000)
select_app.click()

app_list = page.locator(
    "ul.select-dropdown-list>li.select-dropdown-option"
)
app_list.first.wait_for(state="visible", timeout=30000)

lis = []
for i in range(app_list.count()):
    app_name = app_list.nth(i).get_attribute("title")
    if app_name:
        lis.append(app_name)

select_app.click()

# ============================================================
# RUN AUTOMATION
# ============================================================

prevent_system_sleep()

try:
    for index, app in enumerate(lis):
        current_application_name = app

        if index == 0:
            # Same behavior as the original:
            # first application is already selected.
            process_application(app)
            continue

        select_app = page.locator(
            '//span[text()="Select Application"]'
        ).first
        select_app.click()

        option = page.locator(
            "ul.select-dropdown-list>li.select-dropdown-option"
        ).filter(has_text=app).first
        option.wait_for(state="visible", timeout=30000)
        option.click()

        wait_for_loader_after_action()
        get_table()
        process_application(app)

except Exception as automation_error:
    total_errors += 1
    error_details.append({
        "application": current_application_name,
        "vm_hostname": "N/A",
        "error": str(automation_error)
    })

finally:
    allow_system_sleep()

    automation_end_time = datetime.now()
    automation_duration = automation_end_time - automation_start_time

    original_print("")
    original_print("=" * 72)
    original_print("AUTOMATION EXECUTION SUMMARY")
    original_print("=" * 72)

    original_print(
        f"Start time                    : "
        f"{automation_start_time.strftime('%Y-%m-%d %H:%M:%S')}"
    )
    original_print(
        f"End time                      : "
        f"{automation_end_time.strftime('%Y-%m-%d %H:%M:%S')}"
    )
    original_print(
        f"Total execution duration      : "
        f"{str(automation_duration).split('.')[0]}"
    )
    original_print(
        f"Applications available        : {len(lis)}"
    )
    original_print(
        f"Applications processed        : {total_applications_processed}"
    )
    original_print(
        f"Total strategy updates        : {total_strategy_updates}"
    )
    original_print(
        f"Total VMs skipped             : {total_skipped}"
    )
    original_print(
        f"Already matching strategies   : {total_already_matching}"
    )
    original_print(
        f"VMs not found in Excel        : {total_not_found_in_excel}"
    )
    original_print(
        f"Total errors                  : {total_errors}"
    )

    original_print("-" * 72)

    if error_details:
        original_print("ERROR DETAILS")
        original_print("-" * 72)

        for error_number, error_item in enumerate(error_details, start=1):
            original_print(
                f"{error_number}. Application : {error_item['application']}"
            )
            original_print(
                f"   VM Hostname : {error_item['vm_hostname']}"
            )
            original_print(
                f"   Error       : {error_item['error']}"
            )
            original_print("-" * 72)
    else:
        original_print("Error details                 : No errors")

    if (
        total_applications_processed == len(lis)
        and total_errors == 0
    ):
        original_print("Final status                  : SUCCESS")
    elif total_applications_processed > 0:
        original_print(
            "Final status                  : COMPLETED WITH ERRORS"
        )
    else:
        original_print("Final status                  : FAILED")

    original_print("=" * 72)
